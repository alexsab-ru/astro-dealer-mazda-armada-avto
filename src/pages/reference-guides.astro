---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/site/settings.json';
import Banner from '@/blocks/banner/Banner.astro';
import SpecialSalonsInfo from '@/blocks/special-salons-info/SpecialSalonsInfo.astro';
const { site_name, brand, legal_city_where } = settings;
const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/mazda/reference-guides/banner_desktop.webp",
	"mobileImageUrl": "https://cdn.alexsab.ru/pages/mazda/reference-guides/banner_mobile.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Справочные руководства</span></li></ol></nav><h1>Справочные руководства</h1>",
}
---

<Layout title={`Справочные руководства`} description={`Здесь вы можете скачать справочное руководство по вашему автомобилю MAZDA`} image="https://cdn.alexsab.ru/pages/mazda/reference-guides/banner_desktop.webp">
	<Banner banners={[banner]} />

	<section class="content">
		<div class="container">

			<div class="text-center">
				<h2 class="">Справочное руководство владельца MAZDA CX-5</h2>
			
				<p>Здесь вы можете скачать справочное руководство по вашему автомобилю MAZDA CX-5.</p>

				<div class="flex justify-center mt-10 mb-14">
					<a href="https://cdn.alexsab.ru/manuals/mazda/mazda-CX-5.pdf" class="btn !m-0" download="true" target="_blank">Скачать</a>
				</div>
				
				<h2 class="">Справочное руководство владельца MAZDA CX-50/CX-50 HEV</h2>

				<p>Здесь вы можете скачать справочное руководство по вашему автомобилю MAZDA CX-50.</p>

				<div class="flex justify-center mt-10 mb-14">
					<a href="https://cdn.alexsab.ru/manuals/mazda/mazda-CX-50-CX-50-HEV.pdf" class="btn !m-0" download="true" target="_blank">Скачать</a>
				</div>
			</div>

			<SpecialSalonsInfo dataFormName="Узнать подробнее. Справочные руководства" />

		</div>
	</section>

</Layout>