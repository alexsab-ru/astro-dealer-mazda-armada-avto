---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/settings.json';
import Banner from '@/components/Banner/Banner.astro';
import SpecialSalonsInfo from '@/components/SpecialSalonsInfo.astro';
const { brand, legal_city_where } = settings;
const banner = {
	"show": true,
	"type": "video",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/mazda/maintainance/poster.webp",
	"videoUrl": "https://cdn.alexsab.ru/pages/mazda/maintainance/maintainance.mp4",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Техническое обслуживание</span></li></ol></nav><h1>Техническое обслуживание</h1>",
}
---

<Layout title={`Техническое обслуживание`} description={`Техническое обслуживание автомобиля Mazda состоит из ежедневного контрольного осмотра, выполняемого владельцем, периодического техобслуживания, которое проводится в соответствии с установленным регламентом`} image="https://cdn.alexsab.ru/pages/mazda/maintainance/poster.webp">
	<Banner banners={[banner]} />

	<section class="content">
		<div class="container">
			<p>Техническое обслуживание автомобиля Mazda состоит из ежедневного контрольного осмотра, выполняемого владельцем, периодического техобслуживания, которое проводится в соответствии с установленным регламентом на определенных пробегах или календарных сроках эксплуатации, а также операций по уходу за кузовом и салоном автомобиля. Периодическое техническое обслуживание проводится на сервисной станции официального дилера Mazda.</p>
			<p>С полным регламентом операций технического обслуживания вашего автомобиля вы можете ознакомиться в <a href="/manuals/">руководстве по эксплуатации</a>.</p>

			<div class="flex justify-center mt-10">
				<a href="/service-request/" class="btn">Запись на сервис</a>
			</div>

			<SpecialSalonsInfo dataFormName="Узнать подробнее. Техническое обслуживание" />

		</div>
	</section>

</Layout>