---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/settings.json';
import Banner from '@/components/Banner/Banner.astro';
import SpecialSalonsInfo from '@/components/SpecialSalonsInfo.astro';
import AdvantagesList from '@/components/Advantages/List.astro';
const { site_name, brand, legal_city_where } = settings;
const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/mazda/mazda-servis-kontrakt/banner_desktop.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">MAZDA СЕРВИС КОНТРАКТ</span></li></ol></nav><h1>MAZDA СЕРВИС КОНТРАКТ</h1>",
};
const advantages = [ 
    {iconName: 'mdi:hand-coin-outline', iconColor: 'text-accent-500', title: 'Стоимость покрытия 1 000 000 рублей - <br class="hidden lg:block" />одна из самых высоких на рынке'},
    {iconName: 'mdi:star-check-outline', iconColor: 'text-accent-500', title: 'Покрытие ремонта узлов и агрегатов полностью, <br class="hidden lg:block" />без дробления на составные части'},
    {iconName: 'mdi:reload', iconColor: 'text-accent-500', title: 'Возможность воспользоваться программой в <br class="hidden lg:block" />любом официальном центре Mazda, <br class="hidden lg:block" />участвующем программе'},
    {iconName: 'mdi:credit-card-outline', iconColor: 'text-accent-500', title: 'Прозрачные условия программы и минимальные <br class="hidden lg:block" />ограничения по перечню подлежащих ремонту <br class="hidden lg:block" />деталей'}
];
---

<Layout title={`MAZDA СЕРВИС КОНТРАКТ`} description={`Заключая Mazda Сервис Контракт, вы получаете ремонт самых важных узлов и агрегатов в официальных сервисных центрах по высоким стандартам с использованием фирменного диагностического оборудования.`} image="https://cdn.alexsab.ru/pages/mazda/mazda-servis-kontrakt/banner_desktop.webp">
	<Banner banners={[banner]} />

	<section class="content">
		<div class="container">

				<h2 class="text-center">Фирменная забота о вашем автомобиле после истечения гарантийного срока</h2>
				
				<p>Поломка двигателя, трансмиссии, рулевого управления или основных электрических систем — не просто досадная неприятность, от которой не застрахована даже самая надежная техника. Это еще и незапланированные расходы на ремонт и, как правило, отсутствие возможности пользоваться автомобилем.</p>

				<p>Заключая Mazda Сервис Контракт, вы получаете ремонт самых важных узлов и агрегатов в официальных сервисных центрах по высоким стандартам с использованием фирменного диагностического оборудования. Все работы проводятся квалифицированными и аттестованными специалистами Mazda со строгим соблюдением всех технологий.</p>

				<h3 class="text-center my-10 !mb-10">Преимущества Mazda Сервис Контракт</h3>

				<AdvantagesList items={advantages} classes="grid sm:grid-cols-2 gap-5 lg:gap-10 text-center mb-10 md:mb-20" />

				<h3 class="my-10 mb-7!">Какие автомобили могут участвовать в программе?</h3>
				<p>Все автомобили с бензиновыми двигателями, произведенные на заводе ООО «Мазда Соллерс Мануфэкчуринг Рус» или импортированные ООО «Мазда Мотор Рус» возрастом от 3 до 7 лет и с пробегом до 150 000 км, либо моложе 3 лет с пробегом от 100 000 до 150 000 км, если они удовлетворяют сервисным требованиям.</p>

				<h3 class="my-10 mb-7!">Стоимость и срок действия контракта</h3>
				<p>Абонентская плата составляет 40 000 рублей, вкл. НДС, на 12 месяцев, продлевать действие контракта можно каждый год.</p>

				<h3 class="my-10 mb-7!">Какие детали, узлы и агрегаты подлежат ремонту в рамках контракта?</h3>
				<p>В случае обнаружения неисправностей ремонту подлежат:</p>
				<ul>
					<li>Двигатель в сборе и системы двигателя (включая, но не ограничиваясь: впускная, выпускная, топливная, охлаждения, смазки и т. д.);</li>
					<li>Трансмиссия (включая, но не ограничиваясь: АКПП, МКПП, раздаточная коробка, редукторы, муфта полного привода, карданные и приводные валы, механизм выбора передач и т.д.);
					Гидропривод сцепления (главный и рабочий цилиндры, трубки, шланги);</li>
					<li>Система кондиционирования воздуха (включая, но не ограничиваясь: компрессор, электромагнитная муфта, конденсатор, осушитель, испаритель, трубки, шланги и т.д.);</li>
					<li>Электрооборудование (включая, но не ограничиваясь: стартер, генератор, датчики, проводка, электромагнитные и вакуумные клапаны, подогревы, электроприводы люка, сидений, стекол, зеркал, багажника и т.д.);</li>
					<li>Электронные модули (блоки управления систем автомобиля);</li>
					<li>Рулевое управление (включая, но не ограничиваясь: рулевая колонка, рулевая рейка, система электроусилителя руля и т.д.);</li>
					<li>Тормозная система (включая главный и рабочие тормозные цилиндры, вакуумный усилитель, трубки,&nbsp;шланги).</li>
				</ul>
				<!-- <p>С перечнем компонентов, которые исключены из МСК, но являются составными частями перечисленных узлов и агрегатов, можно ознакомиться в&nbsp;<a href="https://files.platform.perxis.ru/cu726j0beucc7390k490?sign=Njk2ZjU2Y2R8RDhCUUljT29wMmhGMWtEQnxXNPi7nzJ9jxsU1lyd5_TArBysBNGC-4DeVkeHUypsBg%3D%3D" target="_blank">приложении к соглашению</a>.</p> -->

				<h3 class="my-10 mb-7!">Основные преимущества программы</h3>
				<ul>
					<li>Доступная стоимость участия в программе в сравнении с объемом предоставляемых услуг.</li>
					<li>Стоимость покрытия ремонта 1 000 000 рублей - одна из самых высоких на рынке</li>
					<li>Минимальные ограничения по перечню подлежащих ремонту деталей.</li>
					<li>Прозрачные условия программы - узлы и агрегаты покрываются условиями программы полностью (без дробления на составные части).</li>
					<li>Широкая география распространения - возможность воспользоваться программой в любом официальном центре Mazda на всей территории РФ.</li>
				</ul>

				<h3 class="my-10 mb-7!">Сервисные требования к автомобилю для участия в программе</h3>
				<p>У автомобиля должна быть прозрачная сервисная история: прохождение всех регламентных ТО у официальных дилеров Mazda, отраженное в электронной сервисной книжке. Автомобиль должен быть исправен, а также исключены технические модификации (доработки) автомобиля, не предусмотренные заводом-изготовителем. Программа МСК не распространяется на автомобили из такси, каршеринга, сервисов аренды, обучения вождению и т.п.</p>

				<h3 class="my-10 mb-7!">Диагностика автомобиля</h3>
				<p>Каждый автомобиль-кандидат должен пройти диагностику в официальном сервисном центре Mazda по единой карте осмотра. Автомобили с серьезными техническими недостатками мы принять не сможем, но легкие недочеты поможем устранить — чтобы в итоге владелец мог заключить контракт. Диагностика проводится на платной основе, но если по ее итогу автомобиль признается исправным, стоимость включается в сумму контракта. И, в любом случае, у вас на руках останется диагностическая карта с перечнем выявленных неисправностей и рекомендациями по их устранению.</p>

				<h3 class="my-10 mb-7!">Отличие от других видов сервисной поддержки</h3>
				<p>Mazda Сервис Контракт не является страховым продуктом. Вы заключаете договор непосредственно с дилером или сервисным партнером Mazda. Это прямая и честная сделка, основанная на тех же принципах, как и при покупке нового автомобиля.</p>

				<h3 class="my-10 mb-7!">Кто может участвовать в программе</h3>
				<p>Предложение действительно только для физических лиц.</p>
				<!-- <p>Чтобы ознакомиться с детальными условиями программы МСК, скачайте образец соглашения по&nbsp;этой&nbsp;<a href="https://files.platform.perxis.ru/cu726j0beucc7390k490?sign=Njk2ZjU2Y2R8RDhCUUljT29wMmhGMWtEQnxXNPi7nzJ9jxsU1lyd5_TArBysBNGC-4DeVkeHUypsBg%3D%3D" target="_blank">ссылке</a>.</p> -->

			<SpecialSalonsInfo dataFormName="Узнать подробнее. MAZDA СЕРВИС КОНТРАКТ" />

		</div>
	</section>

</Layout>